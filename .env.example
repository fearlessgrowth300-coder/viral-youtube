# Required for OpenAI transcription, moment refinement, and AI voiceover.
OPENAI_API_KEY=

# OpenAI models. Change these if your account uses different model names.
OPENAI_ANALYSIS_MODEL=gpt-5-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=cedar

# Optional local neural narration. Download the model using the README command.
PIPER_MODEL_PATH=.tools/piper-voices/en_US-libritts-high.onnx
PIPER_SPEAKER_ID=0

# Optional reliable YouTube transcript provider.
TRANSCRIPT_API_KEY=

# Source safety. Only enable this for YouTube content you own or have permission to process.
ALLOW_YOUTUBE_DOWNLOAD=false

# Rendering options.
BACKGROUND_AUDIO_PATH=
BACKGROUND_VOLUME=0.12
CLIP_LENGTH_SECONDS=45

# Publishing is disabled by default. Leave manual review enabled until you trust the workflow.
PUBLISH_ENABLED=false
REQUIRE_MANUAL_REVIEW=true

# YouTube Data API upload.
YOUTUBE_CLIENT_SECRETS=
YOUTUBE_TOKEN_FILE=.secrets/youtube_token.json
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_CATEGORY_ID=24

# TikTok Content Posting API.
TIKTOK_ACCESS_TOKEN=
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# Instagram Graph API / Instagram API.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_API_VERSION=v23.0
PUBLIC_MEDIA_BASE_URL=
